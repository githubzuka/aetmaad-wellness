# ============================================================
# Frontend environment (Vite — baked in at BUILD time)
# Set these in your frontend host (Vercel → Settings → Environment Variables)
# and REDEPLOY afterwards; changing them without a rebuild has no effect.
# ============================================================

# Public URL of the deployed backend
VITE_API_URL=https://aetmaad-backend.onrender.com


# ============================================================
# Backend environment (used by backend/server.js)
# Set these in your backend host (Render → Environment)
# ============================================================

PORT=5000
NODE_ENV=production

# MongoDB connection string
MONGO_URI=

# Auth
JWT_SECRET=
JWT_EXPIRE=7d

# Extra allowed CORS origins (comma-separated).
# Any *.vercel.app and *.onrender.com origin is allowed automatically.
CORS_ORIGINS=https://aetmaad-wellness.vercel.app

# Email (volunteer approvals, notifications)
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=

# AI assistant (optional)
GROQ_API_KEY=
